---
/*
 * De homepage in het Engels, op `/`. De vijf andere talen komen uit
 * [lang]/index.astro; de inhoud staat in HomeGrid, zodat er niets dubbel is.
 *
 * Fase 2 hangt hier de feed en het uitgelichte artikel in.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeGrid from '../components/HomeGrid.astro';
import { getNewsCount } from '../config/nav';

const count = await getNewsCount();
---

<BaseLayout locale="en">
  <HomeGrid locale="en" count={count} />
</BaseLayout>
