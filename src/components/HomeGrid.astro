---
/*
 * Het tweekoloms-grid van richting 1C: links één uitgelicht item groot,
 * rechts het volledige archief als pillijst.
 *
 * Fase 2 vult de twee slots met echte posts. Boven 900 px twee kolommen,
 * daaronder gestapeld met uitgelicht boven. `min-width: 0` op beide kolommen
 * is essentieel: zonder dat breekt de ellipsis van de pillen.
 *
 * Het grid blijft twee kolommen, ook bij honderden posts. Uitdrukkelijke
 * keuze (§5): niet omschakelen naar een kaartengrid als het archief groeit.
 *
 * De teller rechts is er niet meer (11 september 2026): het getal zei de
 * lezer niets en verspringt bij elk filter.
 */
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  /**
   * Of de twee kolommen inhoud hebben. Expliciet, en niet met
   * `Astro.slots.has()`: die zegt ook ja als de slot wel meegegeven is maar
   * niets rendert, en dan blijft er een kop staan zonder iets eronder.
   */
  hasFeatured?: boolean;
  hasList?: boolean;
}

const { locale, hasFeatured = false, hasList = false } = Astro.props;
const t = useTranslations(locale);

---

<div class="mm-home">
  <section class="mm-home__col" aria-label={t('featured.label')}>
    <h2 class="mm-home__label">{t('featured.label')}</h2>
    {hasFeatured ? <slot name="featured" /> : <p class="mm-home__empty">{t('list.empty')}</p>}
  </section>

  <section class="mm-home__col" aria-label={t('list.heading')}>
    <div class="mm-home__listhead">
      <h2 class="mm-home__label">{t('list.heading')}</h2>
    </div>
    {hasList ? <slot name="list" /> : <p class="mm-home__empty">{t('list.empty')}</p>}
  </section>
</div>

<style>
  .mm-home {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 26px;
  }

  .mm-home__col {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .mm-home__label {
    font-family: var(--mm-display);
    font-size: 14px;
    letter-spacing: .18em;
    color: var(--mm-muted);
  }

  .mm-home__listhead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 4px;
  }

  .mm-home__empty {
    font-size: 13.5px;
    color: var(--mm-muted);
  }

  @media (max-width: 899px) {
    .mm-home {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    /*
     * Gestapeld hebben de twee kolommen een scheiding nodig, anders loopt
     * het uitgelichte artikel zonder pauze over in de lijst.
     */
    .mm-home__col + .mm-home__col {
      padding-top: 14px;
      border-top: 1px solid var(--mm-border);
    }
  }
</style>
