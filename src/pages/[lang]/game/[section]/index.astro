---
/*
 * Een Game-sectie in de vijf niet-standaardtalen: /nl/game/map enzovoort.
 * Engels heeft geen voorvoegsel en staat in ../../game/[section]/index.astro.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LeonidaMap from '../../../../components/LeonidaMap.astro';
import RegionList from '../../../../components/RegionList.astro';
import { getRegions } from '../../../../lib/regions';
import { defaultLocale, locales, type Locale } from '../../../../i18n/ui';
import { localizePath, useTranslations } from '../../../../i18n/utils';
import { breadcrumbJsonLd } from '../../../../lib/structured-data';

export async function getStaticPaths() {
  const regions = await getRegions(defaultLocale);
  if (regions.length === 0) return [];
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((lang) => ({ params: { lang, section: 'map' } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);
const regions = await getRegions(locale);

/* De broodkruimel als gestructureerde data (§17); zie de Engelse route. */
const jsonLd = {
  '@context': 'https://schema.org',
  ...breadcrumbJsonLd(
    [
      { name: t('crumb.home'), path: localizePath('', locale) },
      { name: t('map.title'), path: Astro.url.pathname },
    ],
    Astro.site,
  ),
};
---

<BaseLayout locale={locale} title={t('map.title')} description={t('map.description')} fixedHeight>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />
  <div class="mm-mappage">
    <h1 class="mm-mappage__title">{t('map.title')}</h1>

    <div class="mm-mappage__cols">
      <LeonidaMap locale={locale} regions={regions} fill />
      <RegionList locale={locale} regions={regions} />
    </div>
  </div>
</BaseLayout>

<style>
  /*
   * De kaartpagina vult het scherm: koptekst boven, voettekst onder, en de
   * kaart daartussen. Zo is er niets te scrollen op de pagina zelf en houdt
   * de kaart het muiswiel voor zichzelf.
   *
   * Onder 1100 px valt dat weg: dan staat de gebiedenlijst onder de kaart en
   * moet de pagina wel kunnen scrollen.
   */
  .mm-mappage {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
    flex: 1 1 auto;
    min-height: 0;
  }

  .mm-mappage__title { font-size: 32px; line-height: 1; }

  /*
   * Leonida is staand en smal. Naast elkaar gebruikt de kaart de hoogte en
   * de lijst de breedte die overblijft.
   */
  .mm-mappage__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
    gap: 20px;
    align-items: stretch;
    flex: 1 1 auto;
    min-height: 0;
  }

  @media (min-width: 1100px) {
    /* De lijst scrollt in zichzelf, zodat de pagina dat niet hoeft. */
    .mm-mappage__cols > :global(.mm-regions) {
      min-height: 0;
      overflow-y: auto;
      padding-right: 4px;
    }
  }

  @media (max-width: 1099px) {
    .mm-mappage__cols {
      grid-template-columns: minmax(0, 1fr);
      flex: none;
    }

    .mm-mappage { flex: none; }
    .mm-mappage__title { font-size: 30px; }
  }
</style>
