---
/*
 * Het uitgelichte artikel, links op de homepage (§5). Eén artikel, groot,
 * dat niet doorrolt: een carousel blijft verboden.
 *
 * Beeld met het categorielabel erover, dan de titel, de samenvatting en een
 * metaregel met de datum en het hartje. Beeld én titel wijzen naar dezelfde
 * detailpagina.
 */
import type { Post } from '../lib/posts';
import type { Locale } from '../i18n/ui';
import { shortDate, isoDate } from '../lib/date';
import CategoryBadge from './CategoryBadge.astro';
import PostImage from './PostImage.astro';
import LikeButton from './LikeButton.astro';

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const postId = `${post.category}/${post.slug}`;
---

<article class="mm-featured">
  <a class="mm-featured__shot" href={post.href} tabindex="-1" aria-hidden="true">
    <PostImage image={post.image} alt={post.imageAlt ?? ''} variant="featured">
      <CategoryBadge category={post.category} locale={locale} overlay />
    </PostImage>
  </a>

  <h3 class="mm-featured__title">
    <a href={post.href}>{post.title}</a>
  </h3>

  <p class="mm-featured__summary">{post.description}</p>

  <div class="mm-featured__meta">
    <time datetime={isoDate(post.date)}>{shortDate(post.date, locale)}</time>
    <LikeButton postId={postId} locale={locale} />
  </div>
</article>

<style>
  .mm-featured {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .mm-featured__shot { display: block; }

  .mm-featured__title {
    font-size: 40px;
    line-height: 1;
  }

  .mm-featured__summary {
    font-size: 16px;
    line-height: 1.65;
    max-width: 48ch;
    color: var(--mm-muted);
  }

  .mm-featured__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 13.5px;
    color: var(--mm-muted);
  }

  @media (max-width: 899px) {
    .mm-featured__title { font-size: 28px; line-height: 1.02; }
    .mm-featured__summary { font-size: 14.5px; line-height: 1.6; }
  }
</style>
