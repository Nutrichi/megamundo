---
/*
 * Streams in de vijf niet-standaardtalen: /nl/streams, /fr/streams enzovoort.
 * Engels staat in ../../streams; de regels staan daar uitgelegd.
 */
import FeedPage from '../../../components/FeedPage.astro';
import { feedHasContent } from '../../../lib/feeds';
import { defaultLocale, locales, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  if (!feedHasContent('streams')) return [];
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { lang: locale, index: undefined } }));
}

const locale = Astro.params.lang as Locale;
---

<FeedPage kind="streams" locale={locale} />
