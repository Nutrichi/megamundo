---
/*
 * De voettekst (PROJECT_SPEC.md §16): één zin die zegt wat de site is, de
 * links naar YouTube en Discord, en de verplichte disclaimer.
 *
 * Een sociale link verschijnt alleen als zijn URL in config/site.ts staat.
 */
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { social } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const links = [
  { label: t('footer.youtube'), href: social.youtube },
  { label: t('footer.discord'), href: social.discord },
].filter((link) => link.href !== '');
---

<footer class="mm-footer" aria-label={t('footer.label')}>
  <div class="mm-footer__inner">
    <div class="mm-footer__text">
      <p class="mm-footer__tagline">{t('site.tagline')}</p>
      <p class="mm-footer__disclaimer">{t('site.disclaimer')}</p>
    </div>

    {links.length > 0 && (
      <ul class="mm-footer__links">
        {links.map((link) => (
          <li>
            <a href={link.href} rel="noopener" class="mm-footer__link">{link.label}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</footer>

<style>
  .mm-footer {
    border-top: 1px solid var(--mm-border);
    background: var(--mm-header);
  }

  .mm-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 36px;
    width: 100%;
    max-width: var(--mm-max);
    margin: 0 auto;
    padding: 20px 26px 24px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--mm-muted);
  }

  .mm-footer__text {
    flex: 1 1 320px;
    min-width: 0;
    max-width: 46ch;
  }

  .mm-footer__tagline { color: var(--mm-body); }

  .mm-footer__links {
    margin: 0;
    margin-left: auto;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 20px;
  }

  .mm-footer__link {
    font-family: var(--mm-display);
    font-size: 16px;
    letter-spacing: .1em;
    color: var(--mm-muted);
    transition: color .16s ease;
  }

  .mm-footer__link:hover { color: var(--mm-ink); }

  @media (max-width: 899px) {
    .mm-footer__inner {
      gap: 18px;
      padding: 20px 16px 24px;
    }

    .mm-footer__links { margin-left: 0; }
  }
</style>
