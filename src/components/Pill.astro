---
/*
 * De pil (§5.1) — het belangrijkste component van de site. Deze vorm komt
 * overal terug: archief, clips, streams.
 *
 * De herziene vorm, niet de eerste. Van links naar rechts: een kolom van
 * vaste breedte met een palmboompje in de categoriekleur (tot 11 september
 * 2026 een ruitje), een scheidingslijn,
 * de titel op één regel, dezelfde scheidingslijn nog eens, en een kolom van
 * vaste breedte met het hartje en de telling.
 *
 * Twee dingen zijn uitdrukkelijk afgekeurd en staan hier dus niet: de
 * linkerkolom vullen met de categoriekleur als achtergrond, en de
 * waardekolom laten meebewegen. Die kolom heeft een vaste breedte en een
 * lijn aan beide kanten, juist zodat alle hartjes netjes onder elkaar
 * uitlijnen. Dat is het hele punt van die kolom.
 *
 * Mobiel: de titel kapt af met een ellipsis; links en rechts krimpen nooit.
 * `min-width: 0` op de titelcel is daarvoor essentieel — zonder dat werkt
 * de ellipsis niet.
 */
import type { Post } from '../lib/posts';
import { categories } from '../config/categories';
import type { Locale } from '../i18n/ui';
import LikeButton from './LikeButton.astro';

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const category = categories[post.category];
/*
 * De sleutel waaronder de likes van deze post in de database staan. Bewust
 * de collectie en niet de categorie: een categorie kan veranderen (een post
 * verhuist van GTA Online naar GTA VI) en dan zouden de likes eraan
 * verdwijnen. De collectie ligt vast zolang de post bestaat.
 */
const postId = `${post.collection}/${post.slug}`;

/*
 * De categorie staat ook als tekst in de link. Het ruitje is kleur, en
 * kleur alleen mag nooit de enige drager van betekenis zijn; een
 * schermlezer hoort dus "News, <titel>".
 */
const categoryLabel = category.label;
---

<li
  class="mm-pill"
  data-mm-post
  data-category={post.category}
  data-title={post.title.toLowerCase()}
>
  <span class="mm-pill__cat" aria-hidden="true">
    <svg class="mm-pill__palm" style={`--mm-palm: ${category.color};`} viewBox="0 0 24 24" fill="currentColor">
      <!-- De kroon -->
      <path d="M12 8.3C9.5 5 5 4.6 2 7.4c3.2-.4 6 .6 7.6 2.6z" />
      <path d="M12 8.3c2.5-3.3 7-3.7 10-.9-3.2-.4-6 .6-7.6 2.6z" />
      <path d="M12 8.3C11.4 4.2 8.4 1.4 4.6 1.4c2.6 1.4 4.6 3.8 5.4 7z" />
      <path d="M12 8.3c.6-4.1 3.6-6.9 7.4-6.9-2.6 1.4-4.6 3.8-5.4 7z" />
      <path d="M12 9c-2.3.1-4.6 1.8-5.6 4.6 1.8-1.5 3.8-2.3 5.9-2.2z" />
      <path d="M12 9c2.3.1 4.6 1.8 5.6 4.6-1.8-1.5-3.8-2.3-5.9-2.2z" />
      <!-- De stam, die in het heuveltje zakt: de boom staat op een eilandje -->
      <path d="M11 9.3c1.3 3.2 1.5 6.6.7 10h2.2c.8-3.5.6-7-.8-10.3z" />
      <path d="M3.5 22.5c2-2.2 5.1-3.4 8.5-3.4s6.5 1.2 8.5 3.4z" />
    </svg>
  </span>

  <span class="mm-pill__rule" aria-hidden="true"></span>

  <a class="mm-pill__link" href={post.href}>
    <span class="mm-sr">{categoryLabel}, </span>
    <span class="mm-pill__title">{post.title}</span>
  </a>

  <span class="mm-pill__rule" aria-hidden="true"></span>

  <span class="mm-pill__value">
    <LikeButton postId={postId} locale={locale} />
  </span>
</li>

<style>
  .mm-pill {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    min-height: 42px;
    background: var(--mm-raised);
    border: 1px solid var(--mm-border);
    border-radius: var(--mm-r-pill);
    overflow: hidden;
    /*
     * Alleen de rand animeert; de gloed staat er meteen (11 september 2026).
     * Een geanimeerde box-shadow tekent de pil zestien beelden lang opnieuw,
     * met het gefilterde palmboompje erbij. Over een lijst van vijftig pillen
     * voelde dat traag, vooral in Safari; zonder is het rekenwerk bij het
     * bewegen van de muis 14 tot 32 % lager.
     */
    transition: border-color .16s ease;
  }

  .mm-pill:hover,
  .mm-pill:focus-within {
    border-color: var(--mm-accent-cyan);
    box-shadow: var(--mm-glow-pill);
  }

  /* Vaste kolom met alleen het palmboompje. Nooit een gevuld kleurvlak. */
  .mm-pill__cat {
    flex: none;
    width: 40px;
    align-self: stretch;
    display: grid;
    place-items: center;
  }

  /*
   * Het palmboompje (Nutri, 11 september 2026): de kleur van de categorie en
   * dezelfde gloed als het ruitje dat er stond. Een eigen tekening, geen
   * materiaal van Rockstar (§2.4). De kleur loopt via `currentColor`, want
   * een CSS-variabele in het fill-attribuut van SVG werkt niet (§13).
   */
  .mm-pill__palm {
    width: 16px;
    height: 16px;
    color: var(--mm-palm);
    filter: drop-shadow(0 0 4px var(--mm-palm));
  }

  .mm-pill__rule {
    flex: none;
    width: 1px;
    align-self: stretch;
    background: var(--mm-border);
  }

  .mm-pill__link {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0 14px;
    font-size: 14.5px;
    color: var(--mm-ink-soft);
  }

  /*
   * De hele pil is klikbaar, zonder de knop erin te omvatten: de link legt
   * een onzichtbaar vlak over de pil en het hartje ligt daarboven.
   */
  .mm-pill__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .mm-pill__title {
    display: block;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mm-pill__value {
    position: relative;
    z-index: 1;
    flex: none;
    width: 76px;
    align-self: stretch;
    display: flex;
  }

  /*
   * De knop vult de hele waardekolom. Anders raakt een klik naast het
   * hartje, maar nog wel binnen het vakje, de link die over de pil ligt en
   * ga je naar de post in plaats van te liken.
   *
   * `:global`, want de knop komt uit LikeButton en draagt het
   * scope-attribuut van dit bestand niet.
   */
  .mm-pill__value :global(.mm-like),
  .mm-pill__value :global(.mm-like__button) {
    width: 100%;
    align-self: stretch;
  }

  .mm-pill__value :global(.mm-like__button) { cursor: pointer; }

  /* De focusring van de link hoort om de pil, niet om het onzichtbare vlak. */
  .mm-pill__link:focus-visible { outline: none; }

  .mm-pill:has(.mm-pill__link:focus-visible) {
    outline: 2px solid var(--mm-accent-cyan);
    outline-offset: 2px;
  }

  /* Nieuw bijgeladen pillen komen rustig binnen (§ "LOAD MORE"). */
  .mm-pill.is-new { animation: mmRise .4s ease both; }

  @media (max-width: 899px) {
    .mm-pill { min-height: 44px; } /* raakvlak */
    .mm-pill__cat { width: 34px; }
    .mm-pill__palm { width: 14px; height: 14px; }
    .mm-pill__link { font-size: 13.5px; }
    .mm-pill__value { width: 62px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-pill.is-new { animation: none; }
  }
</style>
