---
/*
 * De rechterkolom van de homepage: het volledige archief als pillijst, met
 * LOAD MORE eronder (§5).
 *
 * Er is geen tweede pagina waar de rest staat. Elke post staat in de HTML,
 * dat is wat een crawler ziet en straks ook wat Pagefind indexeert (§15),
 * en wat nog niet aan de beurt is staat er verborgen bij.
 *
 * **Bijladen gebeurt vanzelf** (11 september 2026), maar alleen tot de
 * posts van een maand oud (6 oktober 2026). Kom je onderaan de lijst, dan
 * verschijnt de volgende reeks; wat ouder is dan een maand komt er pas bij
 * met de knop MORE NEWS. De knop staat er ook voor wie geen JavaScript heeft
 * of met het toetsenbord werkt.
 *
 * **Scheidingen naar ouderdom** (6 oktober 2026): een smalle regel boven de
 * eerste post die ouder is dan 3 dagen, 1 week, 2 weken, 1 maand, 6 maanden
 * of 1 jaar (`lib/age.ts`). De build zet ze al neer, de browser zet ze
 * opnieuw: de build kan uren oud zijn, en na filteren of zoeken hoort een
 * scheiding boven de eerste zichtbare post van zijn stap.
 *
 * Filteren en zoeken gebeuren in dezelfde lijst en op dezelfde manier: niets
 * wordt opnieuw opgehaald, er verandert alleen wat zichtbaar is.
 */
import type { Post } from '../lib/posts';
import type { Locale } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import { subscribePath } from '../config/site';
import { ageBucket, ageBuckets, ageLimits, ageRank, type AgeBucket } from '../lib/age';
import Pill from './Pill.astro';

interface Props {
  posts: Post[];
  locale: Locale;
}

const { posts, locale } = Astro.props;
const t = useTranslations(locale);

/**
 * Hoeveel pillen er meteen staan, en hoeveel LOAD MORE erbij zet. Eén getal
 * voor allebei: dan is de knop voorspelbaar.
 */
const STEP = 15;

/*
 * De knop naar de inschrijving voor de nieuwsbrief (6 oktober 2026; tot dan
 * stond hier SUBMIT NEWS). Dezelfde regel als bij de sociale links in de
 * voettekst: een lege waarde betekent geen knop.
 */
const subscribeHref = subscribePath ? localizePath(subscribePath, locale) : '';

/** De scheidingen zoals de build ze ziet: boven de eerste post van elke stap. */
const limits = ageLimits(new Date());
let rank = 0;
const rows = posts.map((post) => {
  const bucket = ageBucket(post.date, limits);
  const divider: AgeBucket | null = ageRank(bucket) > rank ? bucket : null;
  rank = Math.max(rank, ageRank(bucket));
  return { post, divider };
});
---

<div class="mm-list" data-mm-list data-step={STEP}>
  {posts.length === 0 ? (
    <p class="mm-list__empty">{t('list.empty')}</p>
  ) : (
    <>
      <ul class="mm-list__items" data-mm-items>
        {rows.map(({ post, divider }) => (
          <>
            {divider && <li class="mm-list__age" data-mm-age={divider}>{t(`list.age.${divider}`)}</li>}
            <Pill post={post} locale={locale} />
          </>
        ))}
      </ul>

      <!-- De labels van de scheidingen, voor het script. -->
      <template data-mm-age-labels {...Object.fromEntries(ageBuckets.map((b) => [`data-${b}`, t(`list.age.${b}`)]))}></template>

      <p class="mm-list__empty" data-mm-noresults hidden>{t('list.noResults')}</p>

      <!-- Het baken dat het bijladen op gang brengt zodra het in beeld komt. -->
      <div data-mm-sentinel aria-hidden="true"></div>

      <div class="mm-list__actions">
        <button type="button" class="mm-btn is-secondary" data-mm-more hidden>
          {t('list.loadMore')}
        </button>

        {subscribeHref && (
          <a class="mm-btn is-primary" href={subscribeHref}>{t('list.subscribe')}</a>
        )}
      </div>
    </>
  )}
</div>

<style>
  .mm-list {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .mm-list__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  /*
   * De scheiding: klein, gedempt, met een haarlijn erachter. Meer niet; de
   * pillen blijven het beeld dragen. Globaal, want het script zet de
   * scheidingen opnieuw en die krijgen het kenmerk van Astro niet.
   */
  .mm-list :global(.mm-list__age) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 9px 0 2px;
    font-family: var(--mm-display);
    font-size: 13px;
    letter-spacing: .14em;
    color: var(--mm-muted);
  }

  .mm-list :global(.mm-list__age)::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--mm-border);
  }

  .mm-list__empty {
    font-size: 13.5px;
    color: var(--mm-muted);
    padding: 12px 0;
  }

  /* Eén pixel hoog: genoeg om een plek in de opmaak te hebben. */
  .mm-list [data-mm-sentinel] { height: 1px; }

  .mm-list__actions {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-top: 14px;
  }

  .mm-btn {
    border-radius: var(--mm-r-pill);
    padding: 9px 0;
    text-align: center;
    font-family: var(--mm-display);
    font-size: 16px;
    letter-spacing: .12em;
    transition: var(--mm-transition);
  }

  .is-secondary {
    border: 1px solid var(--mm-border);
    color: var(--mm-ink);
  }

  .is-secondary:hover { border-color: var(--mm-accent-cyan); }

  .is-primary {
    background: var(--mm-accent-pink);
    color: var(--mm-bg);
    box-shadow: var(--mm-glow-primary);
    border: 1px solid var(--mm-accent-pink);
  }

  @media (max-width: 899px) {
    .mm-btn { padding: 11px 0; }
  }
</style>

<script>
  import '../scripts/pill-list';
</script>
