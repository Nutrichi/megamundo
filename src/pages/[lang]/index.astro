---
/*
 * De homepage in de vijf niet-standaardtalen: /nl/, /fr/, /es/, /it/, /de/.
 * Engels heeft geen voorvoegsel en staat in ../index.astro (§11). Het
 * uitgelichte artikel staat ook hier óók in de lijst; zie daar waarom.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeGrid from '../../components/HomeGrid.astro';
import FeaturedPost from '../../components/FeaturedPost.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, pickFeatured } from '../../lib/posts';
import { websiteJsonLd } from '../../lib/structured-data';
import { defaultLocale, locales, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { lang: locale } }));
}

const locale = Astro.params.lang as Locale;
const posts = await getPosts(locale);
const featured = pickFeatured(posts);

/* Gestructureerde data (§17); zie ../index.astro waarom dit hier staat. */
const jsonLd = websiteJsonLd(locale, Astro.site);
---

<BaseLayout locale={locale} filter>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />
  <HomeGrid
    locale={locale}
    hasFeatured={!!featured}
    hasList={posts.length > 0}
  >
    {featured && <FeaturedPost slot="featured" post={featured} locale={locale} />}
    {posts.length > 0 && <PostList slot="list" posts={posts} locale={locale} />}
  </HomeGrid>
</BaseLayout>
