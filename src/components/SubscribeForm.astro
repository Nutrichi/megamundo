---
/*
 * De inschrijving op de nieuwsbrief (PROJECT_SPEC.md §5.5, 6 oktober 2026).
 *
 * Eén veld, het e-mailadres. Het komt in de tabel `subscribers` in Supabase;
 * er gaat nog geen mail uit. De verzending komt later met een maildienst, en
 * die stuurt dan de bevestiging en de afmeldlink (`supabase/README.md`).
 *
 * Dezelfde drempels tegen bots als bij het inzendformulier: een honeypot,
 * een minimale tijd, en in de database hoogstens drie inschrijvingen per uur
 * per browser. Geen captcha van een derde partij (§21).
 */
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Een adres intypen gaat sneller dan een tip schrijven. */
const minSeconds = 2;
---

<form class="mm-subscribe" data-mm-subscribe data-min-seconds={minSeconds} data-lang={locale} novalidate>
  <p class="mm-subscribe__intro">{t('subscribe.intro')}</p>

  <label class="mm-subscribe__field">
    <span class="mm-subscribe__label">{t('subscribe.fieldEmail')}</span>
    <input type="email" name="email" maxlength="254" required autocomplete="email" inputmode="email" />
  </label>

  <!-- De honeypot, zoals in SubmitForm. -->
  <div class="mm-subscribe__pot" aria-hidden="true">
    <label>
      Website
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="mm-subscribe__actions">
    <button type="submit" class="mm-subscribe__button" data-mm-subscribe-button>
      {t('subscribe.send')}
    </button>
    <p class="mm-subscribe__error" data-mm-subscribe-error role="alert" hidden></p>
  </div>

  <p class="mm-subscribe__consent">
    {t('subscribe.consent')} <a href="/privacy/">{t('subscribe.privacy')}</a>
  </p>

  <template
    data-mm-subscribe-text
    data-send={t('subscribe.send')}
    data-sending={t('subscribe.sending')}
    data-email={t('subscribe.errorEmail')}
    data-network={t('submit.errorNetwork')}
    data-storage={t('submit.errorStorage')}
    data-fast={t('submit.errorTooFast')}
  ></template>
</form>

<div class="mm-subscribe__done" data-mm-subscribe-done hidden>
  <p class="mm-subscribe__thanks">{t('subscribe.thanks')}</p>
  <p class="mm-subscribe__thanksnote">{t('subscribe.thanksNote')}</p>
</div>

<style>
  .mm-subscribe {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 560px;
  }

  .mm-subscribe__intro {
    font-size: 15px;
    line-height: 1.65;
    color: var(--mm-muted);
  }

  .mm-subscribe__field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mm-subscribe__label {
    font-family: var(--mm-display);
    font-size: 16px;
    letter-spacing: .08em;
    color: var(--mm-ink);
  }

  .mm-subscribe input {
    margin-top: 4px;
    width: 100%;
    padding: 10px 12px;
    background: var(--mm-raised);
    border: 1px solid var(--mm-border);
    border-radius: var(--mm-r-field-lg);
    font: inherit;
    font-size: 15px;
    color: var(--mm-ink);
    transition: var(--mm-transition);
  }

  .mm-subscribe input:focus {
    outline: none;
    border-color: var(--mm-accent-cyan);
  }

  .mm-subscribe__pot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .mm-subscribe__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mm-subscribe__button {
    align-self: flex-start;
    padding: 10px 26px;
    background: var(--mm-accent-pink);
    border: 1px solid var(--mm-accent-pink);
    border-radius: var(--mm-r-pill);
    box-shadow: var(--mm-glow-primary);
    font-family: var(--mm-display);
    font-size: 16px;
    letter-spacing: .12em;
    color: var(--mm-bg);
  }

  .mm-subscribe__button[disabled] { opacity: .6; cursor: default; }

  .mm-subscribe__error {
    font-size: 13.5px;
    color: var(--mm-accent-pink);
  }

  .mm-subscribe__consent {
    font-size: 12.5px;
    color: var(--mm-muted);
  }

  .mm-subscribe__consent a {
    color: var(--mm-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .mm-subscribe__done {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 560px;
  }

  .mm-subscribe__thanks {
    font-family: var(--mm-display);
    font-size: 26px;
    color: var(--mm-ink);
  }

  .mm-subscribe__thanksnote {
    font-size: 14px;
    line-height: 1.6;
    color: var(--mm-muted);
  }
</style>

<script>
  import { subscribeNewsletter } from '../lib/supabase';

  const form = document.querySelector<HTMLFormElement>('[data-mm-subscribe]');
  const done = document.querySelector<HTMLElement>('[data-mm-subscribe-done]');

  if (form && done) {
    const text = form.querySelector<HTMLElement>('[data-mm-subscribe-text]')!.dataset;
    const button = form.querySelector<HTMLButtonElement>('[data-mm-subscribe-button]')!;
    const error = form.querySelector<HTMLElement>('[data-mm-subscribe-error]')!;
    const minSeconds = Number(form.dataset.minSeconds ?? '2');
    const loadedAt = Date.now();

    const fail = (message: string) => {
      error.textContent = message;
      error.hidden = false;
    };

    const finish = () => {
      form.hidden = true;
      done.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;

      const data = new FormData(form);
      const value = (name: string) => String(data.get(name) ?? '').trim();

      // De honeypot: doen alsof het gelukt is, zoals in SubmitForm.
      if (value('website')) {
        finish();
        return;
      }

      if (Date.now() - loadedAt < minSeconds * 1000) {
        fail(text.fast ?? '');
        return;
      }

      // Dezelfde ruwe vorm als in de database; de maildienst doet later de
      // echte controle met een bevestigingsmail.
      const email = value('email');
      if (email.length > 254 || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        fail(text.email ?? '');
        return;
      }

      button.disabled = true;
      button.textContent = text.sending ?? '';

      const result = await subscribeNewsletter(email, form.dataset.lang ?? 'en');

      button.disabled = false;
      button.textContent = text.send ?? '';

      if (result.ok) {
        finish();
        return;
      }

      fail(result.reason === 'storage' ? (text.storage ?? '') : (text.network ?? ''));
    });
  }
</script>
